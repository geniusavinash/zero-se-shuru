# This project reads its keys from environment variables.
# On the owner's laptop they are Windows user variables, set with tools\set-keys.ps1 (no .env file).
# In GitHub Actions they are repository secrets. Anyone else may copy this file to .env instead.
AZURE_OPENAI_API_KEY=
# https://<resource>.openai.azure.com/openai/v1/
AZURE_OPENAI_BASE_URL=
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
CONTACT_EMAIL=
